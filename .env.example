# Copy to .env.local for local development (never commit real values).
# In production, set these in Vercel: Project → Settings → Environment Variables.
# See docs/INSTAGRAM_SETUP.md for how to get each one.

# Required: Instagram access token from the Meta app ("Unified login" EAA... or "Instagram login" IG...).
INSTAGRAM_ACCESS_TOKEN=

# Optional, Unified login (EAA) tokens only: the Instagram account ID. Found automatically
# if left empty; setting it skips one lookup per feed refresh.
INSTAGRAM_USER_ID=

# Required in production: any long random string. Vercel sends it with cron requests
# so only the scheduled job can refresh the token.
CRON_SECRET=

# Optional: only show posts tagged with this hashtag (without the #), e.g. rayflics
INSTAGRAM_HASHTAG=

# Optional: comma-separated post links or shortcodes to hide, e.g.
# https://www.instagram.com/p/ABC123/,XYZ789
INSTAGRAM_EXCLUDE=

# Set automatically when you add Upstash Redis from the Vercel Marketplace.
# Stores the refreshed token and a last-good copy of the feed.
KV_REST_API_URL=
KV_REST_API_TOKEN=
